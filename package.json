{
  "name": "@withone/mcp",
  "version": "2.5.3",
  "description": "The local MCP server for One. Three tools that give your agent every app you have connected, over stdio with an API key.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "agents",
    "integrations",
    "oauth",
    "api",
    "automation",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "chatgpt",
    "one"
  ],
  "type": "module",
  "bin": {
    "mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "test": "node scripts/run-tests.mjs",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.20.0",
    "form-data": "^4.0.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  },
  "author": {
    "name": "One",
    "email": "support@withone.ai",
    "url": "https://withone.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withoneai/mcp.git"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "mcpName": "ai.withone/mcp"
}
